# Copiar para .env e preencher. NUNCA commitar o .env.

# Aplicação
APP_ENV=development
APP_NAME=NOSSA Campo

# Base de dados (SQLite para o MVP)
DATABASE_URL=sqlite:///./nossa_campo.db

# JWT (gerar uma chave própria: openssl rand -hex 32)
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
